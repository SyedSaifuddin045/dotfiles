#!/usr/bin/env bash

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"

# Reset media presence state so it re-syncs after a restart/reload
echo 0 > /tmp/sb_media_present
echo 0 > /tmp/sb_media_count

# Bar
sketchybar --bar height=30 \
  position=top \
  color=0xff1e1e2e \
  margin=0 \
  padding_left=3 padding_right=24 \
  sticky=on \
  topmost=window

# Default styling (JetBrainsMono Nerd Font for icons)
sketchybar --default \
  icon.font="JetBrainsMono Nerd Font:Regular:13.0" \
  label.font="JetBrainsMono Nerd Font:Regular:13.0" \
  icon.color=0xffcdd6f4 \
  label.color=0xffcdd6f4 \
  background.height=24 \
  background.corner_radius=6 \
  background.color=0x00000000 \
  icon.padding_left=3 icon.padding_right=3 \
  label.padding_left=3 label.padding_right=3

# --- AeroSpace workspaces (left) ---
sketchybar --add event aerospace_workspace_change

for sid in 1 2 3 4 5; do
  sketchybar --add item space.$sid left \
    --subscribe space.$sid aerospace_workspace_change \
    --set space.$sid \
    icon="$sid" \
    icon.color=0xffcdd6f4 \
    icon.padding_left=5 icon.padding_right=5 \
    label="" \
    label.font="sketchybar-app-font:Regular:13.0" \
    label.padding_left=4 \
    label.color=0xffcdd6f4 \
    padding_left=3 padding_right=3 \
    background.drawing=off \
    background.color=0xff89b4fa \
    background.height=24 \
    background.corner_radius=6 \
    click_script="aerospace workspace $sid" \
    script="$PLUGIN_DIR/aerospace.sh $sid"
done

# last workspace sits flush against the divider
sketchybar --set space.5 padding_right=0

# Refresh workspace app-icon previews on aerospace workspace change,
# window open/close (windows_refresh), app switches, plus 10s poll as
# safety net for background-app closes (AeroSpace emits no close event)
sketchybar --add event windows_refresh
sketchybar --add item space_windows left \
  --subscribe space_windows aerospace_workspace_change windows_refresh front_app_switched \
  --set space_windows \
  drawing=off \
  update_freq=10 \
  script="$PLUGIN_DIR/space_windows.sh"

# Divider between workspace cluster and focused-app pill
sketchybar --add item space_sep left \
  --subscribe space_sep aerospace_workspace_change \
  --set space_sep \
  label="│" \
  label.color=0xff45475a \
  label.padding_left=4 label.padding_right=12 \
  padding_left=0 padding_right=0 \
  script="$PLUGIN_DIR/divider.sh"

# Focused app icon + name (left)
sketchybar --add item front_app left \
  --set front_app \
  icon.font="sketchybar-app-font:Regular:14.0" \
  icon.color=0xffcdd6f4 \
  icon.padding_right=3 \
  label.color=0xffcdd6f4 \
  label.max_chars=24 \
  background.drawing=on \
  background.color=0x3d7f849c \
  background.border_width=0 \
  background.padding_left=3 background.padding_right=3 \
  update_freq=1 \
  script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

# Network bandwidth (left side — long labels here would push the right
# cluster's cpu into the notch)
sketchybar --add item network left \
  --set network \
  padding_left=3 \
  update_freq=2 \
  script="$PLUGIN_DIR/network.sh"

# --- Right side (added rightmost-first) ---
# Battery (icon updates on level + power_source_change)
sketchybar --add item battery right \
  --set battery \
  update_freq=60 \
  script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery power_source_change

# Clock
sketchybar --add item clock right \
  --set clock \
  update_freq=30 \
  script="$PLUGIN_DIR/clock.sh"

# Media: song progress slider
sketchybar --add slider media_progress right \
  --set media_progress \
  drawing=off \
  slider.width=40 \
  slider.percentage=0 \
  slider.highlight_color=0xff89b4fa \
  slider.knob.drawing=off \
  slider.background.height=4 \
  slider.background.corner_radius=2 \
  slider.background.color=0x40ffffff \
  update_freq=1 \
  script="$PLUGIN_DIR/media_progress.sh" \
  click_script="$PLUGIN_DIR/media_seek.sh"

# Media: info + controls (prev, play, next left-to-right)
sketchybar --add item media_info right \
  --set media_info \
  drawing=off \
  update_freq=1 \
  label.max_chars=16 \
  script="$PLUGIN_DIR/media_info.sh"

sketchybar --add item media_next right \
  --set media_next icon="" \
  drawing=off \
  click_script="nowplaying-cli next"

sketchybar --add item media_play right \
  --set media_play \
  drawing=off \
  icon.width=16 \
  update_freq=1 \
  script="$PLUGIN_DIR/media_play.sh" \
  click_script="nowplaying-cli togglePlayPause"

sketchybar --add item media_prev right \
  --set media_prev icon="" \
  drawing=off \
  click_script="nowplaying-cli previous"

# Activity: RAM
sketchybar --add item ram right \
  --set ram \
  update_freq=2 \
  script="$PLUGIN_DIR/ram.sh"

# Activity: Disk (beside RAM, unified % format)
sketchybar --add item disk right \
  --set disk \
  update_freq=2 \
  script="$PLUGIN_DIR/disk.sh"

# Activity: CPU
sketchybar --add item cpu right \
  --set cpu \
  update_freq=2 \
  script="$PLUGIN_DIR/cpu.sh"

# Ghost spacers between section pills (paddings are a single knob on items,
# so external gaps need dedicated transparent items)
sketchybar --add item sec_gap1 right \
  --set sec_gap1 \
  label="" icon="" \
  background.drawing=off \
  padding_left=3 padding_right=3

sketchybar --add item sec_gap2 right \
  --set sec_gap2 \
  label="" icon="" \
  background.drawing=off \
  padding_left=3 padding_right=3

# Force right-side order: controls -> media title -> progress bar -> stats
# right-side items render right-to-left, so the list is reversed
sketchybar --reorder clock battery sec_gap2 media_progress media_info media_next media_play media_prev sec_gap1 disk ram cpu

# --- Section pills (right side), styled to match the front_app pill ---
sketchybar --add bracket stats_bracket cpu ram disk \
  --set stats_bracket \
  background.color=0x3d7f849c \
  background.corner_radius=6 \
  background.height=24 \
  background.padding_left=3 background.padding_right=3

# Single media pill: controls + title + slider
sketchybar --add bracket media_bracket media_prev media_play media_next media_info media_progress \
  --set media_bracket \
  background.color=0x3d7f849c \
  background.corner_radius=6 \
  background.height=24 \
  background.padding_left=3 background.padding_right=3

sketchybar --add bracket status_bracket clock battery \
  --set status_bracket \
  background.color=0x3d7f849c \
  background.corner_radius=6 \
  background.height=24 \
  background.padding_left=3 background.padding_right=3

# Populate workspace app-icon previews on startup
"$PLUGIN_DIR/space_windows.sh"